# Copy to .env for local development, or enter values in Komodo > Stack > Environment.
# Never commit real passwords or SMTP credentials.
SMTP_PROBE_PASSWORD=
SMTP_PROBE_PASSWORD_MIN_LENGTH=15

# For production only, replace with your actual public HTTPS origin.
# PUBLIC_ORIGIN=https://smtp.example.com
# NPM_NETWORK=proxied
# SMTP_PROBE_IMAGE=ghcr.io/texomans/smtp-probe:v0.2.0-beta.1

# Verified SMTP probing accepts any PUBLIC DNS hostname by default.
SMTP_ALLOWED_HOSTS=

# Sending is OFF by default. Admin must opt in explicitly.
ALLOW_SEND=0
SMTP_SEND_ALLOWED_HOSTS=
# Comma-separated exact addresses or mailbox wildcards (NOT *@*):
# SMTP_SEND_ALLOWED_RECIPIENTS=admin@example.com,*@example.org
SMTP_SEND_ALLOWED_RECIPIENTS=

# Previously named SMTP Scope? Old SMTP_SCOPE_PASSWORD and
# SMTP_SCOPE_PASSWORD_MIN_LENGTH are still accepted during migration.
# Do not set both old and new passwords; SMTP_PROBE_PASSWORD wins.
