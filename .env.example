# Copy to .env, set your secret and keep .env OUT of source control.
SMTP_PROBE_PASSWORD=
SMTP_PROBE_PASSWORD_MIN_LENGTH=15
SMTP_PROBE_IMAGE=ghcr.io/texomans/smtp-probe:v0.2.0-beta.1

# Private default Compose binds to host loopback.
SMTP_PROBE_PORT=3088

# For compose.proxy.yaml only; set your own HTTPS origin and proxy network:
# PUBLIC_ORIGIN=https://smtp.example.com
# SMTP_PROBE_PROXY_NETWORK=your-existing-proxy-network

# Blank = any public SMTP hostname (private addresses are still denied).
SMTP_ALLOWED_HOSTS=

# Email sending stays disabled unless deliberately authorized.
ALLOW_SEND=0
SMTP_SEND_ALLOWED_HOSTS=
# SMTP_SEND_ALLOWED_RECIPIENTS=admin@example.com,*@example.org
SMTP_SEND_ALLOWED_RECIPIENTS=
